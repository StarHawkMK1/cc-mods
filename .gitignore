# 로컬 도구 캐시 (graft 인덱서 세션/텔레메트리 파일)
graft/

# Claude Code가 mod를 로드할 때마다 생성하는 TypeScript 타입
**/.claude-plugin/types/

# 대화형 --plugin-dir 로드 시 Claude Code가 mod 루트에 추가하는 tsconfig (위 types/를 extends)
mods/*/tsconfig.json

# 디버그 로그 (예: claude --debug-file ./mod-debug.log)
*.log

# 로컬 도구 작업 파일 (superpowers 작업 폴더, graft의 ripgrep 설정)
.superpowers/
/.ignore
